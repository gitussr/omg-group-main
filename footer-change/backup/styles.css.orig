/* changes by 05-01-2026 */
.primary-btn-3{ background:#F4D6A0 ; color:var(--dark-color); outline:1px solid var(--dark-color);}
.primary-btn-3 svg{ fill:var(--dark-color); }
header .top-bar .main-block .contact-btn{ background-color: #EECD92;}

header .whatsapp-link {
  flex-direction: column;
  height: 60px;
/*   width: 60px; */
  margin-block: 5px; margin-block: 0px;
  position: relative;
  color:#000 !important;
  transition:0.3s ease-in-out; gap: 8px; flex-direction: initial; height: 48px;
}
header .whatsapp-link:hover{ background:#d0ae70;   transition:0.3s ease-in-out; }
header .whatsapp-link:hover > svg{ fill:#000 !important;}
header .whatsapp-link:hover{ transform: scale(1);}

header .top-bar .main-block .star-block .text a{ text-decoration:none; }
footer .bottom-block .social-media li a svg{width:80%; height:80%; }


footer .bottom-block .social-media{ display:initial;}
footer .bottom-block .social-media li .wrapper{ display:flex; gap:7px; align-items:center; }
footer .bottom-block .social-media li + li .wrapper{ margin-top:clamp(14px, 1.042vw, 20px);}
footer .bottom-block .social-media li .wrapper p{ color:var(--primary-solid-color);}
footer .bottom-block .social-media li a:hover {
	transform: translate(5px, -2px);
	transition: 0.3s ease-in-out;
}

footer .bottom-block .social-media{ display:flex; flex-direction:column; align-items:left; gap:0; }