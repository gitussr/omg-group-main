#gform_confirmation_message_1 {
   background: linear-gradient(135deg, #e6f9f0, #f4fffb);
   border-inline: 5px solid #22c55e;
   padding: 18px 22px;
   border-radius: 10px;
   color: #14532d;
   font-size: 16px;
   font-weight: 500;
   line-height: 1.6;
   margin-top: 20px;
   text-align: center;
}
